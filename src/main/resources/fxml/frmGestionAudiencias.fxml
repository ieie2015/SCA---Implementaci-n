<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.seminario.controller.GestionAudienciasController">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <Label text="Audiencias pendientes de planificación" />
            <Label text="Seleccione una audiencia para completar su programación." />
        </VBox>
    </top>
    <center>
        <VBox spacing="10.0">
            <TableView fx:id="tvAudiencias" prefHeight="280.0">
                <columns>
                    <TableColumn fx:id="colNroAudiencia" prefWidth="140.0" text="N° Audiencia" />
                    <TableColumn fx:id="colIdSolicitud" prefWidth="140.0" text="ID Solicitud" />
                    <TableColumn fx:id="colCuij" prefWidth="140.0" text="CUIJ" />
                    <TableColumn fx:id="colCaratula" prefWidth="240.0" text="Carátula" />
                    <TableColumn fx:id="colTipoAudiencia" prefWidth="150.0" text="Tipo Audiencia" />
                    <TableColumn fx:id="colEstado" prefWidth="190.0" text="Estado" />
                    <TableColumn fx:id="colDuracion" prefWidth="140.0" text="Duración (min)" />
                </columns>
            </TableView>
            <Label fx:id="lblAudienciaSeleccionada" text="No hay audiencia seleccionada." />
            <HBox spacing="10.0">
                <Label text="Fecha:" />
                <DatePicker fx:id="dpFecha" onAction="#cargarSalas" />
                <Label text="Azul: con salas  |  Rojo: sin salas" />
                <Label text="Sala:" />
                <ComboBox fx:id="cbSala" onAction="#cargarHorarios" disable="true" prefWidth="220.0" />
                <Label text="Hora:" />
                <ComboBox fx:id="cbHora" disable="true" prefWidth="110.0" />
            </HBox>
            <Label text="Participantes disponibles (seleccione uno o más)" />
            <TableView fx:id="tvParticipantes" prefHeight="150.0">
                <columns>
                    <TableColumn fx:id="colTipoParticipante" prefWidth="160.0" text="Tipo" />
                    <TableColumn fx:id="colNombreParticipante" prefWidth="280.0" text="Nombre" />
                    <TableColumn fx:id="colDocumentoParticipante" prefWidth="160.0" text="DNI" />
                    <TableColumn fx:id="colSeleccionar" prefWidth="120.0" text="Seleccionar" />
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnProgramar" onAction="#programarAudiencia"
                    disable="true" text="Programar audiencia" />
            <Button onAction="#refrescar" text="Actualizar Audiencias" />
            <Button onAction="#volverMenuPrincipal" text="Volver al menú principal" />
        </HBox>
    </bottom>
</BorderPane>
