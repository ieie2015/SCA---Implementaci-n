<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.seminario.controller.GestionAudienciasController">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <Label text="Audiencias pendientes de planificación" />
            <Label text="Estas audiencias fueron creadas por CU01 y están listas para CU02." />
        </VBox>
    </top>
    <center>
        <TableView fx:id="tvAudiencias" prefHeight="400.0"
                   prefWidth="800.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colNroAudiencia"
                             prefWidth="150.0"
                             text="N° Audiencia" />
                <TableColumn fx:id="colIdSolicitud"
                             prefWidth="180.0"
                             text="ID Solicitud" />
                <TableColumn fx:id="colTipoAudiencia"
                             prefWidth="160.0"
                             text="Tipo Audiencia" />
                <TableColumn fx:id="colEstado"
                             prefWidth="180.0"
                             text="Estado" />
                <TableColumn fx:id="colDuracion"
                             prefWidth="150.0"
                             text="Duración (min)" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button mnemonicParsing="false"
                    onAction="#refrescar"
                    text="Actualizar" />
            <Button mnemonicParsing="false"
                    onAction="#volverMenuPrincipal"
                    text="Volver al menú principal" />
        </HBox>
    </bottom>
</BorderPane>
